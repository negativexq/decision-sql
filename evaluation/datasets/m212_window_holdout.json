  {
    "id": "m212-holdout-laglead-001",
    "question": "Show the next order date for each customer ordered by time.",
    "category": "lag_lead",
    "pattern": "LEAD",
    "gold_sql": "SELECT \"customer_id\", \"id\", \"ordered_at\", LEAD(\"ordered_at\", 1) OVER (PARTITION BY \"customer_id\" ORDER BY \"ordered_at\" ASC, \"id\" ASC) AS \"next_order_at\" FROM \"orders\"",
    "gold_window_ir": {
      "source_relation": "orders",
      "pattern": "LEAD",
      "physical_outputs": [
        "orders.customer_id",
        "orders.id",
        "orders.ordered_at"
      ],
      "computations": [
        {
          "pattern": "LEAD",
          "target": "orders.ordered_at",
          "partition_by": [
            "orders.customer_id"
          ],
          "order_by": [
