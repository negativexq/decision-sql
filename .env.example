DATABASE_URL=postgresql+psycopg://decision_reader:decision_reader_password@localhost:5432/decision_sql
ADMIN_DATABASE_URL=postgresql+psycopg://decision_admin:decision_admin_password@localhost:5432/decision_sql
# Writable store for the audit log and saved connections (schema decision_meta).
DECISION_SQL_METADATA_DATABASE_URL=postgresql+psycopg://decision_admin:decision_admin_password@localhost:5432/decision_sql
# Fernet key for stored connection passwords. Generate one with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DECISION_SQL_SECRET_KEY=
# Allow installing allowlisted connector drivers from the UI (local use only).
DECISION_SQL_ALLOW_DRIVER_INSTALL=false
OTEL_SERVICE_NAME=decision-sql
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
DECISION_SQL_MAX_PLAN_ROWS=10000000
DECISION_SQL_MAX_PLAN_COST=10000000
DECISION_SQL_MAX_RESULT_ROWS=1000
DECISION_SQL_STATEMENT_TIMEOUT_MS=5000
DECISION_SQL_READER_ROLE=decision_reader
DECISION_SQL_LLM_MODEL=gpt-4o-mini
DECISION_SQL_LLM_BASE_URL=https://api.openai.com/v1
# DECISION_SQL_LLM_API_KEY=
DECISION_SQL_LLM_TIMEOUT_SECONDS=30
# Limits on one question; they stop optional steps, never the first decision or the answer.
DECISION_SQL_RUN_DEADLINE_SECONDS=120
DECISION_SQL_RUN_TOKEN_LIMIT=150000
# DECISION_SQL_RUN_PROBE_QUERY_LIMIT=
# Leave unset for provider-default sampling; some reasoning models reject an explicit temperature.
# DECISION_SQL_LLM_TEMPERATURE=0
# DECISION_SQL_LLM_REASONING_EFFORT=
# Hardened adds question-first output/semantic guidance to new direct generations.
DECISION_SQL_SCHEMA_TOP_K=3
DECISION_SQL_MAX_CONTEXT_TABLES=5
DECISION_SQL_MAX_COLUMNS_PER_TABLE=8
DECISION_SQL_RELATIONSHIP_DEPTH=2
# Schemas with at most this many queryable tables are sent to the model whole.
DECISION_SQL_FULL_CONTEXT_MAX_TABLES=12
