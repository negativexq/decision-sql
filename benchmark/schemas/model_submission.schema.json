{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Decision-SQL provider-safe submission",
  "type": "object",
  "required": ["case_id", "decision", "sql", "reason_code"],
  "additionalProperties": false,
  "properties": {
    "case_id": {"type": "string"},
    "decision": {"type": "string", "enum": ["ANSWER", "BLOCKED_AUTHORITY", "NEEDS_CLARIFICATION", "BLOCKED_POLICY"]},
    "sql": {"type": ["string", "null"]},
    "reason_code": {"type": ["string", "null"], "enum": ["MISSING_AUTHORIZED_RELATIONSHIP", "AMBIGUOUS_SEMANTICS", "READ_ONLY_POLICY", "NO_REASON", null]}
  }
}
