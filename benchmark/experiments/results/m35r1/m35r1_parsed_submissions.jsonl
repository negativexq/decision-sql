{"case_id": "support_01", "case_id_matches": true, "parsed_submission": {"case_id": "support_01", "decision": "ANSWER", "reason_code": null, "sql": "SELECT a.account_id, a.account_name, COUNT(st.ticket_id) FILTER (WHERE st.priority = 'urgent') AS urgent_ticket_count\nFROM accounts AS a\nLEFT JOIN support_tickets AS st ON st.account_id = a.account_id\nGROUP BY a.account_id, a.account_name\nORDER BY a.account_id"}, "provider_metadata": {"finish_reason": "stop", "provider_response_id": "chatcmpl-ELsTnpVCxsamOykdkoGWHQB1GRoWK", "request_id": "req_c18ae358c8c143dbb1e85186d387720e", "resolved_model": "gpt-5.6-luna", "usage": {"completion_tokens": 96, "prompt_tokens": 5176, "reasoning_tokens": 0, "total_tokens": 5272}}, "request_sha256": "d2c9f50626477c0f7d5d266b069b47702e70149514586c945c72bae0be24fd47", "response_sha256": "65bdc8024cbc96da4a72a6702f278612f5029bfa22717b53e2f00a698dc2c945", "schema_validation": "PASS"}
{"case_id": "support_02", "case_id_matches": true, "parsed_submission": {"case_id": "support_02", "decision": "ANSWER", "reason_code": null, "sql": "SELECT t.ticket_id, t.account_id, t.opened_at, r.first_response_at, sp.first_response_sla_hours, r.first_response_at - t.opened_at AS first_response_time FROM support_tickets AS t JOIN accounts AS a ON a.account_id = t.account_id JOIN (SELECT DISTINCT ON (s.account_id) s.account_id, s.plan_id FROM subscriptions AS s ORDER BY s.account_id, s.starts_on DESC, s.subscription_id DESC) AS latest_sub ON latest_sub.account_id = a.account_id JOIN service_plans AS sp ON sp.plan_id = latest_sub.plan_id JOIN (SELECT t2.ticket_id, MIN(e.event_at) AS first_response_at FROM support_tickets AS t2 JOIN ticket_events AS e ON e.ticket_id = t2.ticket_id WHERE e.event_type = 'agent_response' AND e.event_at > t2.opened_at GROUP BY t2.ticket_id) AS r ON r.ticket_id = t.ticket_id WHERE r.first_response_at > t.opened_at + sp.first_response_sla_hours * INTERVAL '1 hour'"}, "provider_metadata": {"finish_reason": "stop", "provider_response_id": "chatcmpl-ELsTqWTh3fkB81BJUhE4vjj9sM67j", "request_id": "req_4b64997fc74343caa0311eda55556d1d", "resolved_model": "gpt-5.6-luna", "usage": {"completion_tokens": 251, "prompt_tokens": 5180, "reasoning_tokens": 0, "total_tokens": 5431}}, "request_sha256": "0876230898d26a5cb0473acf162e3825162c75fc7d604916b8a8aa5c077c4ad7", "response_sha256": "6b0c7b8f76c15add2859ff43019bb471b14bd9cf126a31aac9422f41ff8cf180", "schema_validation": "PASS"}
