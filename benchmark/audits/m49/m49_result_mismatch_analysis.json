      "database_id": "warehouse_logistics",
      "primary_mechanism": "FILTER_SEMANTICS",
      "question": "For each carrier, return the carrier ID and the number of shipments delivered after their promised time. Include only groups represented by at least one qualifying source record.",
      "raw_sql": "SELECT s.carrier_id, COUNT(DISTINCT s.shipment_id) AS late_shipments\nFROM shipments AS s\nJOIN carriers AS c ON c.carrier_id = s.carrier_id\nJOIN delivery_events AS de ON de.shipment_id = s.shipment_id\nWHERE de.event_type = 'delivered'\n  AND de.event_at > s.promised_at\nGROUP BY s.carrier_id",
