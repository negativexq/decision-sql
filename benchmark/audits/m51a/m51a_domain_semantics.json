{
  "healthcare_billing": {
    "business_rules": [
      {
        "definition": "An encounter with status='completed' is a completed visit.",
        "name": "Completed encounter",
        "rule_id": "rule:healthcare_billing:completed_encounter"
      }
    ],
    "metrics": [
      {
        "default_policy": "no implicit default",
        "definition": "Posted patient payments divided by billed charges.",
        "description": "Posted patient payments divided by billed charges.",
        "formula": "SUM(posted payment) / SUM(charge)",
        "grain": "case-defined",
        "metric_id": "metric:healthcare_billing:paid_charge_ratio",
        "name": "paid_charge_ratio",
        "null_policy": "preserve SQL NULL unless explicitly defaulted",
        "operands": [],
        "precision": 4,
        "rounding_stage": "display_only unless question says otherwise",
        "temporal_basis": "case-defined"
      }
    ],
    "policy": {
      "allowed_statement": "one read-only SELECT statement",
      "blocked_decisions": [
        "BLOCKED_POLICY"
      ],
      "forbidden_objects": [
        "pg_authid",
        "secret_tokens"
      ],
      "forbidden_operations": [
        "INSERT",
        "UPDATE",
        "DELETE",
        "MERGE",
        "DDL",
        "COPY",
        "locking reads"
      ],
      "policy_id": "policy:healthcare_billing:readonly"
    },
    "purpose": "Patient encounters, procedures, charges, payments, and clinical coding.",
    "temporal_rules": [
      {
        "benchmark_now": "2026-06-30T12:00:00Z",
        "bounds": "Stored timestamps use UTC and date boundaries are ISO half-open intervals.",
        "clock_mode": "fixed",
        "temporal_rule_id": "time:healthcare_billing:clock",
        "timezone": "UTC"
      }
    ]
  },
