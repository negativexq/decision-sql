{"case_id": "support_05", "case_id_matches": true, "parsed_submission": {"case_id": "support_05", "decision": "ANSWER", "reason_code": null, "sql": "SELECT a.account_id, a.account_name, tc.ticket_count\nFROM accounts AS a\nJOIN (\n    SELECT account_id, COUNT(*) AS ticket_count\n    FROM support_tickets\n    GROUP BY account_id\n) AS tc ON tc.account_id = a.account_id\nWHERE tc.ticket_count > (\n    SELECT AVG(ticket_count)\n    FROM (\n        SELECT account_id, COUNT(*) AS ticket_count\n        FROM support_tickets\n        GROUP BY account_id\n    ) AS counts\n)\nORDER BY a.account_id"}, "provider_metadata": {"finish_reason": "stop", "provider_response_id": "chatcmpl-ELsU7gCm7SeWxXYjH1tHKjEq7rfRT", "request_id": "req_048add304a6d4d7d8fefa86d4168bd69", "resolved_model": "gpt-5.6-luna", "usage": {"completion_tokens": 141, "prompt_tokens": 5183, "reasoning_tokens": 0, "total_tokens": 5324}}, "request_sha256": "e5cfe11a230644f786adc8c2fe14b5dc5b8153386102c40570f96ea1a91936cd", "response_sha256": "729de3586a7a85152e5ee1053cdfcfcbdda2d0bdddd437915bc065231bffbd96", "schema_validation": "PASS"}
