    "kind": "REFERENCE_IMPLEMENTATION_B",
    "sql": "WITH recent AS (SELECT vehicle_id, COUNT(*) AS maintenance_count FROM maintenance_events WHERE performed_at >= TIMESTAMPTZ '2026-05-31 12:00:00+00' AND performed_at < TIMESTAMPTZ '2026-06-30 12:00:00+00' GROUP BY vehicle_id) SELECT v.vehicle_id, COALESCE(recent.maintenance_count, 0)::BIGINT FROM vehicles v LEFT JOIN recent ON recent.vehicle_id = v.vehicle_id ORDER BY v.vehicle_id"
