  {
    "id": "m212-holdout-latest-001",
    "question": "Keep the last order row for each sales representative.",
    "category": "latest_per_group",
    "pattern": "LATEST_PER_GROUP",
    "gold_sql": "SELECT \"sales_rep_id\", \"id\", \"ordered_at\" FROM (SELECT \"sales_rep_id\", \"id\", \"ordered_at\", ROW_NUMBER() OVER (PARTITION BY \"sales_rep_id\" ORDER BY \"ordered_at\" DESC, \"id\" DESC) AS \"__decision_rank_0\" FROM \"orders\") AS \"__decision_window_0\" WHERE \"__decision_rank_0\" = 1",
    "gold_window_ir": {
      "source_relation": "orders",
      "pattern": "LATEST_PER_GROUP",
      "physical_outputs": [
        "orders.sales_rep_id",
        "orders.id",
        "orders.ordered_at"
      ],
      "computations": [
        {
          "pattern": "LATEST_PER_GROUP",
          "partition_by": [
            "orders.sales_rep_id"
          ],
          "order_by": [
            {
              "column": "orders.ordered_at",
              "direction": "DESC"
            }
          ],
          "tie_breakers": [
            {
              "column": "orders.id",
              "direction": "DESC"
            }
          ]
        }
      ]
    },
    "expected_tables": [
      "orders"
    ],
    "order_sensitive": false
  },
