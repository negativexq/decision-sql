  {
    "id": "m212-holdout-running-001",
    "question": "Calculate cumulative refund amount within each order.",
    "category": "running_aggregate",
    "pattern": "RUNNING_AGGREGATE",
    "gold_sql": "SELECT \"order_id\", \"id\", \"amount\", SUM(\"amount\") OVER (PARTITION BY \"order_id\" ORDER BY \"refunded_at\" ASC, \"id\" ASC ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS \"refund_total_to_date\" FROM \"refunds\"",
    "gold_window_ir": {
      "source_relation": "refunds",
      "pattern": "RUNNING_AGGREGATE",
      "physical_outputs": [
        "refunds.order_id",
        "refunds.id",
        "refunds.amount"
      ],
      "computations": [
        {
          "pattern": "RUNNING_AGGREGATE",
          "aggregate": "SUM",
          "target": "refunds.amount",
          "partition_by": [
            "refunds.order_id"
          ],
          "order_by": [
            {
              "column": "refunds.refunded_at",
              "direction": "ASC"
            },
            {
              "column": "refunds.id",
              "direction": "ASC"
            }
          ],
          "alias": "refund_total_to_date"
        }
      ]
    },
    "expected_tables": [
      "refunds"
    ],
    "order_sensitive": false
  },
