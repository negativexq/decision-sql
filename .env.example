APP_ENV=local
DATABASE_URL=postgresql+psycopg://decision_reader:decision_reader_password@localhost:5432/decision_sql
ADMIN_DATABASE_URL=postgresql+psycopg://decision_admin:decision_admin_password@localhost:5432/decision_sql
OTEL_SERVICE_NAME=decision-sql
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
